# infinileague has no Convex functions of its own - it talks to the SAME
# Convex deployment infinidraft uses (see INFINILEAGUE.md in the infinidraft
# repo for why). Copy this file to .env.local and set this to whichever of
# infinidraft's deployment URLs you want to point at locally (its dev
# deployment URL, from infinidraft's own .env.local / `npx convex dev`
# output).
VITE_CONVEX_URL=
